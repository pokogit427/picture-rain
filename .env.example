# Local PostgreSQL settings. Copy to .env only when overriding Compose defaults.
POSTGRES_DB=picture_rain
POSTGRES_USER=picture_rain
POSTGRES_PASSWORD=change-this-local-password

# Set true behind HTTPS in a deployed environment. Keep false for local HTTP.
COOKIE_SECURE=false

# Local-only host bindings. Keep API and web off public interfaces.
API_PORT=8000
WEB_PORT=8080
